# Root reference file. Each service (backend/, frontend/, ai-service/) has its own .env.example — copy those to .env in each service folder.

# backend/.env
DATABASE_URL=postgresql://username:password@localhost:5432/crewhub?schema=public
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_SERVICE_URL=http://localhost:8000

# frontend/.env
VITE_API_URL=http://localhost:5000/api
