# Copy to .env at the repo root before running `docker compose up`.
# docker-compose.yml reads these directly; it does not use the per-service
# .env files under backend/ or frontend/.

POSTGRES_PASSWORD=postgres

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Must match wherever the frontend container is actually reachable from a
# browser (used for CORS and links in emails).
FRONTEND_URL=http://localhost:8080

# First admin account (created automatically on first backend startup).
SEED_ADMIN_EMAIL=admin@crewhub.com
SEED_ADMIN_PASSWORD=change_this_password

# Optional — leave blank to fall back to console-logged emails / local file storage.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
